# AI RADAR Environment Configuration Example
PORT=8000
HOST=127.0.0.1
DEBUG=True

# Database (SQLite with WAL mode or PostgreSQL)
DATABASE_URL=sqlite:///./ai_radar.db

# AI Provider Configuration (gemini / openai / heuristic)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional OpenAI fallback
OPENAI_API_KEY=your_openai_api_key_here

# Autonomous scan interval in minutes
SCAN_INTERVAL_MINUTES=10
